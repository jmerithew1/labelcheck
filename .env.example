# Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional abuse-guard ceilings (requests/minute, per app instance). These are
# the defaults — override only if you scale out and need to divide them.
# Advertised in docs/approach.md §security; read in lib/rateLimit.ts.
#RATE_LIMIT_PER_IP=240
#RATE_LIMIT_GLOBAL=900
